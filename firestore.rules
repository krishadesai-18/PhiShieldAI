rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128) &&
             (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 1024) &&
             data.role in ['user', 'admin'];
    }

    function isValidScan(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.imageUrl is string && data.imageUrl.size() <= 1000000 && 
             (data.get('imageName', '') is string && data.get('imageName', '').size() <= 512) &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.verdict in ['Phishing', 'Safe', 'Suspicious'] &&
             data.confidence is number && data.confidence >= 0 && data.confidence <= 100 &&
             data.analysis is string && data.analysis.size() <= 50000 &&
             data.riskIndicators is list && data.riskIndicators.size() <= 100 &&
             data.timestamp == request.time;
    }

    function isValidReport(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.scanIds is list && data.scanIds.size() <= 50 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().role == existing().role && // Prevent role escalation
                    incoming().userId == existing().userId; // Immutable ID
    }

    match /scans/{scanId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(scanId) && isValidScan(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(reportId) && isValidReport(incoming());
    }
  }
}
